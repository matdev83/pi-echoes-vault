{
  "name": "pi-echoes-vault",
  "version": "0.1.0",
  "description": "EchoesVault for Pi Agent Harness — persistent agent memory: Markdown/Obsidian-compatible knowledge base, daily logs, architecture/ADR pages, session continuity, and OKF-inspired page conventions. Peer: @earendil-works/pi-coding-agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matdev83/pi-echoes-vault.git"
  },
  "homepage": "https://github.com/matdev83/pi-echoes-vault#readme",
  "bugs": {
    "url": "https://github.com/matdev83/pi-echoes-vault/issues"
  },
  "keywords": [
    "pi-agent",
    "pi-extension",
    "agent-memory",
    "persistent-memory",
    "knowledge-base",
    "markdown",
    "obsidian",
    "okf",
    "developer-tools",
    "echoes-vault",
    "pi-coding-agent"
  ],
  "files": [
    "extensions",
    "src",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/vault.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "pi": {
    "extensions": [
      "./extensions/echoes-vault.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@types/node": "^22.15.0",
    "typebox": "^1.1.38",
    "typescript": "^5.8.3"
  }
}
